# Dependencies
node_modules/
.yarn/
.yarnrc
yarn-error.log
package-lock.json
npm-debug.log*

# Build output
target/
dist/
build/
*.tsbuildinfo

# The published WASM package commits its build output so the npm release
# pipeline does not need a Rust toolchain.
!/dist/
!/dist/**

# WASM binding build output
bindings/wasm/pkg/

# IDE and editor files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
.DS_Store

# Environment variables
.env
.env.local
.env.*.local

# Testing
coverage/
.nyc_output/

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# OS files
.DS_Store
Thumbs.db

# Config directory (user-specific, should not be committed)
.orderly-cli/
